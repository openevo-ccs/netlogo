"><circle color="-7500403" filled="true" marked="true" x="96" y="182" diameter="108"/><circle color="-7500403" filled="true" marked="true" x="110" y="127" diameter="80"/><circle color="-7500403" filled="true" marked="true" x="110" y="75" diameter="80"/><line color="-7500403" marked="true" startX="150" startY="100" endX="80" endY="30"/><line color="-7500403" marked="true" startX="150" startY="100" endX="220" endY="30"/></shape><shape name="butterfly" rotatable="true" editableColorIndex="0"><polygon color="-7500403" filled="true" marked="true"><point x="150" y="165"/><point x="209" y="199"/><point x="225" y="225"/><point x="225" y="255"/><point x="195" y="270"/><point x="165" y="255"/><point x="150" y="240"/></polygon><polygon color="-7500403" filled="true" marked="true"><point x="150" y="165"/><point x="89" y="198"/><point x="75" y="225"/><point x="75" y="255"/><point x="105" y="270"/><point x="135" y="255"/><point x="150" y="240"/></polygon><polygon color="-7500403" filled="true" marked="true"><point x="139" y="148"/><point x="100" y="105"/><point x="55" y="90"/><point x="25" y="90"/><point x="10" y="105"/><point x="10" y="135"/><point x="25" y="180"/><point x="40" y="195"/><point x="85" y="194"/><point x="139" y="163"/></polygon><polygon color="-7500403" filled="true" marked="true"><point x="162" y="150"/><point x="200" y="105"/><point x="245" y="90"/><point x="275" y="90"/><point x="290" y="105"/><point x="290" y="135"/><point x="275" y="180"/><point x="260" y="195"/><point x="215" y="195"/><point x="162" y="165"/></polygon><polygon color="-16777216" filled="true" marked="false"><point x="150" y="255"/><point x="135" y="225"/><point x="120" y="150"/><point x="135" y="120"/><point x="150" y="105"/><point x="165" y="120"/><point x="180" y="150"/><point x="165" y="225"/></polygon><circle color="-16777216" filled="true" marked="false" x="135" y="90" diameter="30"/><line color="-16777216" marked="false" startX="150" startY="105" endX="195" endY="60"/><line color="-1677