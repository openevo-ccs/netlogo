{
  "id": "evolution-resource-use-social-behavior",
  "title": "Evolution of Resource Use and Social Behavior (Monitoring and Punishment)",
  "entry_points": {
    "setup": "setup",
    "step": "go",
    "forever_button_display": "Start"
  },
  "controls": {
    "sliders": [
      {
        "name": "Percent-Sustainables",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "default": 20.0
      },
      {
        "name": "Mutation-rate",
        "min": 0.0,
        "max": 10.0,
        "step": 0.5,
        "default": 1.0
      },
      {
        "name": "Number-Agents",
        "min": 0.0,
        "max": "count patches",
        "step": 1.0,
        "default": 200.0
      },
      {
        "name": "Living-costs",
        "min": 0.0,
        "max": "Harvest-sustainable - 1",
        "step": 0.5,
        "default": 4.0
      },
      {
        "name": "Death-rate",
        "min": 0.0,
        "max": 10.0,
        "step": 0.5,
        "default": 1.0
      },
      {
        "name": "Carrying-capacity",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "default": 100.0
      },
      {
        "name": "Growth-rate",
        "min": 0.0,
        "max": 1.0,
        "step": 0.1,
        "default": 0.3
      },
      {
        "name": "Harvest-sustainable",
        "min": 0.0,
        "max": 100.0,
        "step": 0.5,
        "default": 7.0
      },
      {
        "name": "Harvest-greedy",
        "min": 0.0,
        "max": 100.0,
        "step": 0.5,
        "default": 10.0
      },
      {
        "name": "Perception-accuracy",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "default": 100.0
      },
      {
        "name": "Percent-Punishers",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "default": 20.0
      },
      {
        "name": "Costs-punishment",
        "min": 0.0,
        "max": 3.0,
        "step": 0.1,
        "default": 0.8
      },
      {
        "name": "Fine",
        "min": 1.0,
        "max": 20.0,
        "step": 1.0,
        "default": 1.0
      },
      {
        "name": "Costs-perception",
        "min": 0.0,
        "max": 3.0,
        "step": 0.1,
        "default": 0.5
      },
      {
        "name": "Minimum-punishers",
        "min": 1.0,
        "max": 9.0,
        "step": 1.0,
        "default": 1.0
      }
    ],
    "switches": [],
    "choosers": [
      {
        "name": "Punishment",
        "values": [
          "kill",
          "suspend harvest once",
          "pay fine"
        ],
        "default": "suspend harvest once"
      }
    ],
    "buttons": [
      {
        "display": "Start",
        "code": "go",
        "forever": true
      },
      {
        "display": "Once",
        "code": "go",
        "forever": false
      },
      {
        "display": "Setup",
        "code": "setup",
        "forever": false
      }
    ]
  },
  "available_reporters": {
    "msy": "Carrying-capacity * Growth-rate / 4"
  },
  "plot_pens": [
    {
      "plot": "Trait frequencies (%)",
      "pen": "Sustainable, punisher",
      "update_code": "plotxy ticks (count turtles with [color = green] / count turtles) * 100"
    },
    {
      "plot": "Trait frequencies (%)",
      "pen": "Sustainable, not punisher",
      "update_code": "plotxy ticks (count turtles with [color = turquoise] / count turtles) * 100"
    },
    {
      "plot": "Trait frequencies (%)",
      "pen": "Greedy, punisher",
      "update_code": "plotxy ticks ( count turtles with [color = orange] / count turtles) * 100"
    },
    {
      "plot": "Trait frequencies (%)",
      "pen": "Greedy, not punisher ",
      "update_code": "plotxy ticks ( count turtles with [color = red] / count turtles) * 100"
    },
    {
      "plot": "Average energy",
      "pen": "Sustainable, punisher",
      "update_code": "carefully [plot sum [energy] of turtles with [color = green ] / count turtles with [color = green ]][plot 0]"
    },
    {
      "plot": "Average energy",
      "pen": "Sustainable, not punisher",
      "update_code": "carefully [plot sum [energy] of turtles with [color = turquoise ] / count turtles with [color = turquoise ]][plot 0]"
    },
    {
      "plot": "Average energy",
      "pen": "Greedy, punisher",
      "update_code": "carefully [plot sum [energy] of turtles with [color = orange ] / count turtles with [color = orange ]][plot 0]"
    },
    {
      "plot": "Average energy",
      "pen": "Greedy, not punisher",
      "update_code": "carefully [plot sum [energy] of turtles with [color = red ] / count turtles with [color = red ]][plot 0]"
    },
    {
      "plot": "Populations (% of carrying capacity)",
      "pen": "Resource",
      "update_code": "plot (sum [resource] of patches / (count patches * Carrying-capacity)) * 100"
    },
    {
      "plot": "Populations (% of carrying capacity)",
      "pen": "Agents",
      "update_code": "plot (count turtles / count patches) * 100"
    },
    {
      "plot": "Average harvest per iteration",
      "pen": "Sustainble, punisher",
      "update_code": "carefully [plot sum [harvest] of turtles with [color = green] / count turtles with [color = green]][plot 0]"
    },
    {
      "plot": "Average harvest per iteration",
      "pen": "Sustainble, not punisher",
      "update_code": "carefully [plot sum [harvest] of turtles with [color = turquoise] / count turtles with [color = turquoise]][plot 0]"
    },
    {
      "plot": "Average harvest per iteration",
      "pen": "Greedy, punisher",
      "update_code": "carefully [plot sum [harvest] of turtles with [color = orange] / count turtles with [color = orange]][plot 0]"
    },
    {
      "plot": "Average harvest per iteration",
      "pen": "Greedy, not punisher",
      "update_code": "carefully [plot sum [harvest] of turtles with [color = red] / count turtles with [color = red]][plot 0]"
    }
  ]
}