hoice type="double" value="6"/></chooser><chooser x="121" y="177" width="138" height="45" current="0" display="offspring-placement" variable="offspring-placement"><choice type="string" value="local"/><choice type="string" value="anywhere"/></chooser><chooser x="8" y="177" width="106" height="45" current="0" display="interaction" variable="interaction"><choice type="string" value="local"/><choice type="string" value="anywhere"/></chooser><slider x="8" y="308" width="144" height="33" min="0" max="10" default="2.5" step="0.5" direction="Horizontal" display="Living-costs" variable="Living-costs"/><input x="49" y="408" width="50" height="60" multiline="false" type="number" variable="A">3.0</input><input x="167" y="408" width="50" height="60" multiline="false" type="number" variable="C">0.0</input><input x="219" y="408" width="50" height="60" multiline="false" type="number" variable="B">5.0</input><input x="168" y="478" width="50" height="60" multiline="false" type="number" variable="D">1.0</input><slider x="7" y="233" width="145" height="33" min="0" max="10" default="0.5" step="0.5" direction="Horizontal" display="Mutation-rate" variable="Mutation-rate" units="%"/><slider x="7" y="270" width="146" height="33" min="0" max="10" default="0.5" step="0.5" direction="Horizontal" display="Death-rate" variable="Death-rate" units="%"/><slider x="8" y="101" width="250" height="33" min="0" max="100" default="50.0" step="1" direction="Horizontal" display="Percent-cooperate-with-same" variable="Percent-cooperate-with-same" units="%"/><slider x="8" y="139" width="250" height="33" min="0" max="100" default="50.0" step="1" direction="Horizontal" display="Percent-cooperate-with-different" variable="Percent-cooperate-with-different" units="%"/><input x="101" y="408" width="50" height="60" multiline="false" type="number" variable="A">3.0</input><note x="9" y="353" width="271" height="56" fontSize="11" textColorLight="0" textColorDark="0" backgroundLight="0" backgroundDark="0" markdown="fal