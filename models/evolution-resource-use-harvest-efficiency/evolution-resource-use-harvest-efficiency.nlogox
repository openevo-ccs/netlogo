-20] [plot 0]</update></pen><pen display="20 - 30" interval="1.0" mode="0" color="-955883" legend="true"><setup>set-plot-pen-color [191 255 0]</setup><update>carefully [plot average-wealth-20-30] [plot 0]</update></pen><pen display="30 - 40" interval="1.0" mode="0" color="-6459832" legend="true"><setup>set-plot-pen-color yellow</setup><update>carefully [plot average-wealth-30-40] [plot 0]</update></pen><pen display="40 - 50" interval="1.0" mode="0" color="-1184463" legend="true"><setup>set-plot-pen-color [255 191 0 ]</setup><update>carefully [plot average-wealth-40-50] [plot 0]</update></pen><pen display="50 - 60" interval="1.0" mode="0" color="-13840069" legend="true"><setup>set-plot-pen-color [255 128 0]</setup><update>carefully [plot average-wealth-50-60] [plot 0]</update></pen><pen display="60 - 80" interval="1.0" mode="0" color="-14835848" legend="true"><setup>set-plot-pen-color red</setup><update>carefully [plot average-wealth-60-80] [plot 0]</update></pen><pen display="&gt; 80" interval="1.0" mode="0" color="-11221820" legend="true"><setup>set-plot-pen-color [128 0 0]</setup><update>carefully [plot average-wealth-80] [plot 0]</update></pen></plot><slider x="9" y="386" width="173" height="33" min="0" max="10" default="4.0" step="0.1" direction="Horizontal" display="Living-costs" variable="Living-costs"/><slider x="9" y="425" width="172" height="33" min="0" max="10" default="0.5" step="0.1" direction="Horizontal" display="Mutation-rate" variable="Mutation-rate" units="%"/><slider x="10" y="149" width="172" height="33" min="0" max="100" default="50.0" step="1" direction="Horizontal" display="Number-agents" variable="Number-agents"/><chooser x="10" y="196" width="138" height="45" current="1" display="Agents-Appearance" variable="Agents-Appearance"><choice type="string" value="People"/><choice type="string" value="Bacteria"/><choice type="string" value="Circle"/></chooser><plot x="808" y="248" width="400" height="281" xMin="0.0" xMax="10.0" yMin="0.0" yMax="10.0" autoPlotX="true" autoPlotY="false" legend="true" display="Agent Population" yAxis="Number of agents"><setup></setup><update></update><pen display="&lt; 5" interval="1.0" mode="0" color="-16777216" legend="true"><setup>set-plot-pen-color [0 200 0 ]</setup><update><![CDATA[plot count turtles with [harvest-amount < 5]]]></update></pen><pen display="5 - 10" interval="1.0" mode="0" color="-7500403" legend="true"><setup>set-plot-pen-color [0 255 0]</setup><update><![CDATA[plot count turtles with [harvest-amount >= 5 and harvest-amount <= 10]]]></update></pen><pen display="10 - 20" interval="1.0" mode="0" color="-2674135" legend="true"><setup>set-plot-pen-color [128 255 0]</setup><update><![CDATA[plot count turtles with [harvest-amount >= 10 and harvest-amount < 20]]]></update></pen><pen display="20 - 30" interval="1.0" mode="0" color="-955883" legend="true"><setup>set-plot-pen-color [191 255 0]</setup><update><![CDATA[plot count turtles with [harvest-amount >= 20 and harvest-amount < 30]]]></update></pen><pen display="30 - 40" interval="1.0" mode="0" color="-6459832" legend="true"><setup>set-plot-pen-color yellow</setup><update><![CDATA[plot count turtles with [harvest-amount >= 30 and harvest-amount < 40]]]></update></pen><pen display="40 - 50" interval="1.0" mode="0" color="-1184463" legend="true"><setup>set-plot-pen-color [255 191 0 ]</setup><update><![CDATA[plot count turtles with [harvest-amount >= 40 and harvest-amount < 50]]]></update></pen><pen display="50 - 60" interval="1.0" mode="0" color="-10899396" legend="true"><setup>set-plot-pen-color [255 128 0]</setup><update><![CDATA[plot count turtles with [harvest-amount >= 50 and harvest-amount < 60]]]></update></pen><pen display="60 - 80" interval="1.0" mode="0" color="-2674135" legend="true"><setup></setup><update><![CDATA[plot count turtles with [harvest-amount >= 60 and harvest-amount < 80]]]></update></pen><pen display="&gt; 80" interval="1.0" mode="0" color="-13840069" legend="true"><setup>set-plot-pen-color [1