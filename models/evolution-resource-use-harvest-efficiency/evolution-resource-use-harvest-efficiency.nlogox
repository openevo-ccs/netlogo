<?xml version="1.0" encoding="UTF-8"?>
<!-- Converted from legacy .nlogo (originally saved as 'NetLogo 6.2.0') by nlogo_to_nlogox.py. Target format version: 7.0.4. See module docstring for documented conversion assumptions. -->
<model version="NetLogo 7.0.4" snapToGrid="false">
<code><![CDATA[turtles-own [
  harvest-amount
  harvest
  energy
]

patches-own [resource]

globals [
  Carrying-capacity
  growth-rate
 ]

;;;;;;;;;;;;;;;;;;;;;;
;;;Setup Procedures;;;
;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all

  set Carrying-capacity 100
  set growth-rate 0.3

  setup-patches
  setup-turtles

  reset-ticks
end

to setup-patches

 ask patches [
    set resource ( 75 + random (Carrying-capacity / 4))
    set pcolor scale-color brown resource  0 (Carrying-capacity + 30)
  ]
end

to setup-turtles
  ask n-of Number-agents patches
    [sprout 1
      [set energy Living-costs + 1
       set harvest-amount 0.5 + random-float 99
       update-color]]

  ask turtles [
    if Agents-Appearance = "People" [ set shape "person" set size 1]
    if Agents-Appearance = "Bacteria" [ set shape "bacteria" set size 1.2]
    if Agents-Appearance = "Circle" [ set shape "circle" set size 0.8]
     ]
end


;;;;;;;;;;;;;;;;;;;;;;;;
;;;Runtime Procedures;;;
;;;;;;;;;;;;;;;;;;;;;;;;

to go
  if count turtles = 0 [stop]

  ask turtles [
    if Agents-Appearance = "People" [ set shape "person" set size 1]
    if Agents-Appearance = "Bacteria" [ set shape "bacteria" set size 1.2]
    if Agents-Appearance = "Circle" [ set shape "circle" set size 0.8]]

  move
  harvest-patch

  livingcosts

  if Reproduction [reproduce]
  death

  ask patches [
    regrow
    recolor]

  tick
end

to move ;;turtle procedure

 ask turtles [
    let nextpatch max-one-of (patches in-radius 2 with [not any? turtles-here] ) [resource]
    if nextpatch != nobody
      [ face nextpatch
        move-to nextpatch]

    ]
end

to harvest-patch
  ask turtles [
   ifelse [resource] of patch-here > harvest-amount
   [set harvest harvest-amount - (harvest-costs-factor *  ( 1.2 ^ [harvest-amount] of self ))
    ask patch-here [ set resource resource - [harvest-amount] of myself]]
   [set harvest [resource] of patch-here
    ask patch-here [set resource 0]
    ]
    set energy energy + harvest - (harvest-costs-factor *  ( 1.2 ^ [harvest-amount] of self ))
  ]
end

to livingcosts
  ask turtles [set energy energy - Living-costs]
end

to reproduce
 ask turtles
  [ let neighborhood  (patch-set neighbors with [not any? turtles-on self ])
      if (any? neighborhood)  and random-float 1 < ( 0.001 * energy );;/ 100)
        [hatch 1 [
         mutate
         set energy ([energy] of myself / 2)
         move-to one-of neighborhood

          ]
        set energy (energy / 2)
        ]
     ]
end

to mutate  ;; turtle procedure
    if random-float 100 < Mutation-rate
       [set harvest-amount 0.5 + random-float 99]

   update-color
end

to update-color
    if harvest-amount <= 5  [set color [0 200 0 ] ]
    if harvest-amount > 5 and harvest-amount < 10 [set color [0 255 0]]
    if harvest-amount >= 10 and harvest-amount < 20 [set color [128 255 0]] ;;scale-color yellow amount 30 -5]
    if harvest-amount >= 20 and harvest-amount < 30 [set color  yellow ];;scale-color orange amount 60 0]
    if harvest-amount >= 30 and harvest-amount < 40 [set color [191 255 0] ]
    if harvest-amount >= 40 and harvest-amount < 50 [set color [255 191 0 ]]
    if harvest-amount >= 50 and harvest-amount < 60 [set color [255 128 0]] ;;scale-color red amount 80 30]
    if harvest-amount >= 60 and harvest-amount < 80 [set color red]
    if harvest-amount >= 80 [set color [128 0 0]]
   ;;scale-color red amount 100 50]
end

to death
  ask turtles
  [if energy <= 0 [die]
     if random-float 100 < Death-rate [ die ]]

end

to regrow ;; patch
  ifelse resource > 0
  [set resource precision (resource + ((growth-rate * resource) * (1 - (resource / Carrying-capacity )))) 3]
  [ set resource 0.1]
end

to recolor ;; patch
  set pcolor scale-color brown resource 0 (Carrying-capacity + 30)
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;; Turtle variables;;;;;;;;;;;;;;;;;

to-report average-wealth-5
  report sum [energy] of turtles with [harvest-amount < 5] / count turtles with [harvest-amount < 5]
end

to-report average-wealth-5-10
  report sum [energy] of turtles with [harvest-amount >= 5 and harvest-amount < 10 ] / count turtles with [harvest-amount >= 5 and harvest-amount < 10]
end

to-report average-wealth-10-20
  report sum [energy] of turtles with [harvest-amount >= 10 and harvest-amount < 20 ] / count turtles with [harvest-amount >= 10 and harvest-amount < 20]
end

to-report average-wealth-20-30
  report sum [energy] of turtles with [harvest-amount >= 20 and harvest-amount < 30 ] / count turtles with [harvest-amount >= 20 and harvest-amount < 30]
end

to-report average-wealth-30-40
  report sum [energy] of turtles with [harvest-amount >= 30 and harvest-amount < 40 ] / count turtles with [harvest-amount >= 30 and harvest-amount < 40]
end

to-report average-wealth-40-50
  report sum [energy] of turtles with [harvest-amount >= 40 and harvest-amount < 50 ] / count turtles with [harvest-amount >= 40 and harvest-amount < 50]
end

to-report average-wealth-50-60
  report sum [energy] of turtles with [harvest-amount >= 50 and harvest-amount < 60 ] / count turtles with [harvest-amount >= 50 and harvest-amount < 60]
end

to-report average-wealth-60-80
  report sum [energy] of turtles with [harvest-amount >= 60 and harvest-amount < 80 ] / count turtles with [harvest-amount >= 60 and harvest-amount < 80]
end

to-report average-wealth-80
  report sum [energy] of turtles with [harvest-amount >=  80 ] / count turtles with [harvest-amount >=  80]
end]]></code>
