{
  "id": "evolution-resource-use-harvest-efficiency",
  "title": "Evolution of Resource Use with Harvest Efficiency",
  "entry_points": {
    "setup": "setup",
    "step": "go",
    "forever_button_display": "Start"
  },
  "controls": {
    "sliders": [
      {
        "name": "Living-costs",
        "min": 0.0,
        "max": 10.0,
        "step": 0.1,
        "default": 4.0
      },
      {
        "name": "Mutation-rate",
        "min": 0.0,
        "max": 10.0,
        "step": 0.1,
        "default": 0.5
      },
      {
        "name": "Number-agents",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "default": 50.0
      },
      {
        "name": "Death-rate",
        "min": 0.0,
        "max": 10.0,
        "step": 0.5,
        "default": 0.5
      },
      {
        "name": "harvest-costs-factor",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.0
      }
    ],
    "switches": [
      {
        "name": "Reproduction",
        "default": true
      }
    ],
    "choosers": [
      {
        "name": "Agents-Appearance",
        "values": [
          "People",
          "Bacteria",
          "Circle"
        ],
        "default": "Bacteria"
      }
    ],
    "buttons": [
      {
        "display": "Setup",
        "code": "setup",
        "forever": false
      },
      {
        "display": "Start",
        "code": "go",
        "forever": true
      },
      {
        "display": "One round",
        "code": "go",
        "forever": false
      }
    ]
  },
  "available_reporters": {
    "average_harvest_amount_behavior_harvest_amount": "sum [harvest-amount] of turtles / count turtles"
  },
  "plot_pens": [
    {
      "plot": "Populations (% of Carrying capacity)",
      "pen": "Resource",
      "update_code": "plot (sum [resource] of patches / (Carrying-capacity * count patches)) * 100"
    },
    {
      "plot": "Populations (% of Carrying capacity)",
      "pen": "Agents",
      "update_code": "plot ( count turtles / count patches ) * 100"
    },
    {
      "plot": "Average energy of agents",
      "pen": "< 5",
      "update_code": "carefully [plot average-wealth-5] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "5 - 10",
      "update_code": "carefully [plot average-wealth-5-10] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "10 - 20",
      "update_code": "carefully [plot average-wealth-10-20] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "20 - 30",
      "update_code": "carefully [plot average-wealth-20-30] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "30 - 40",
      "update_code": "carefully [plot average-wealth-30-40] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "40 - 50",
      "update_code": "carefully [plot average-wealth-40-50] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "50 - 60",
      "update_code": "carefully [plot average-wealth-50-60] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "60 - 80",
      "update_code": "carefully [plot average-wealth-60-80] [plot 0]"
    },
    {
      "plot": "Average energy of agents",
      "pen": "> 80",
      "update_code": "carefully [plot average-wealth-80] [plot 0]"
    },
    {
      "plot": "Agent Population",
      "pen": "< 5",
      "update_code": "plot count turtles with [harvest-amount < 5]"
    },
    {
      "plot": "Agent Population",
      "pen": "5 - 10",
      "update_code": "plot count turtles with [harvest-amount >= 5 and harvest-amount <= 10]"
    },
    {
      "plot": "Agent Population",
      "pen": "10 - 20",
      "update_code": "plot count turtles with [harvest-amount >= 10 and harvest-amount < 20]"
    },
    {
      "plot": "Agent Population",
      "pen": "20 - 30",
      "update_code": "plot count turtles with [harvest-amount >= 20 and harvest-amount < 30]"
    },
    {
      "plot": "Agent Population",
      "pen": "30 - 40",
      "update_code": "plot count turtles with [harvest-amount >= 30 and harvest-amount < 40]"
    },
    {
      "plot": "Agent Population",
      "pen": "40 - 50",
      "update_code": "plot count turtles with [harvest-amount >= 40 and harvest-amount < 50]"
    },
    {
      "plot": "Agent Population",
      "pen": "50 - 60",
      "update_code": "plot count turtles with [harvest-amount >= 50 and harvest-amount < 60]"
    },
    {
      "plot": "Agent Population",
      "pen": "60 - 80",
      "update_code": "plot count turtles with [harvest-amount >= 60 and harvest-amount < 80]"
    },
    {
      "plot": "Agent Population",
      "pen": "> 80",
      "update_code": "plot count turtles with [harvest-amount > 80]"
    },
    {
      "plot": "Histogram - Distribution of agents by harvest amount",
      "pen": "default",
      "update_code": "histogram [harvest-amount] of turtles"
    }
  ]
}