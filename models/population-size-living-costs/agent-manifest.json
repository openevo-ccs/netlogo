        "min": 0.0,
        "max": 50.0,
        "step": 0.1,
        "default": 30.0
      },
      {
        "name": "number-foresters",
        "min": 0.0,
        "max": 375.0,
        "step": 1.0,
        "default": 2.0
      },
      {
        "name": "growth-rate-trees",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "default": 10.0
      }
    ],
    "switches": [],
    "choosers": [],
    "buttons": [
      {
        "display": "Setup",
        "code": "setup",
        "forever": false
      },
      {
        "display": "Start",
        "code": "go",
        "forever": true
      },
      {
        "display": "One round",
        "code": "go",
        "forever": false
      }
    ]
  },
  "available_reporters": {
    "total_number_of_foresters": "count foresters",
