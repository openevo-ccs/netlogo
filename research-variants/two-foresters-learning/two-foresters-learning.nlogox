<?xml version="1.0" encoding="UTF-8"?>
<!-- Converted from legacy .nlogo (originally saved as 'NetLogo 6.2.0') by nlogo_to_nlogox.py. Target format version: 7.0.4. See module docstring for documented conversion assumptions. -->
<model version="NetLogo 7.0.4" snapToGrid="false">
<code><![CDATA[breed [trees tree]
breed [foresters forester]
breed [fences fence]

foresters-own [
  amount           ;; harvest percent tried this tick (the behavior)
  harvest          ;; wood taken this tick (the payoff)
  wealth           ;; wood taken so far
  cut-level        ;; the forester's current typical harvest percent
  block-b          ;; harvest percents tried in the current block of ticks
  block-p          ;; wood taken in the current block of ticks
  prev-block-mean  ;; mean harvest percent of the previous block, -1 before the first block ends
  first-block-p    ;; mean wood per tick in the first block, -1 before it ends
  last-S           ;; the law's predicted change after the latest block
  pending-S        ;; prediction waiting to be compared with the next block
  last-change      ;; observed change between the latest two blocks
  s-log            ;; predictions that have been compared with an observed change
  change-log       ;; the matching observed changes
]

trees-own [height]

globals [
  forest1
  forest2
  farmers1
  farmers2
]

;;;;;;;;;;;;;;;;;;;;;;
;;;Setup Procedures;;;
;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all

  setup-forests
  setup-trees
  if Private-forest? [setup-fence]
  setup-farmers

  reset-ticks
end

to setup-forests
  ask patches [set pcolor brown + 2]
  set forest1 patch-set patches with [pxcor < 5]
  set forest2 patch-set patches with [pxcor >= 5]
end

to setup-trees
  ask patches [
    sprout-trees 1 [
      set shape "tree"
      set color green - 2
      set height Max-Treeheight
      set size ( height / 100 )
    ]
  ]
end

to setup-fence
  ask patches with [ pxcor = 4 ] [
    sprout-fences 1 [
      set shape "thick line"
      set color grey
      set xcor 4.5
      ifelse pycor  < 4
      [facexy 4.5 5 ]
      [facexy 4.5 0 ]
    ]
  ]
end

to setup-farmers
  ask patches with [pxcor = 2 and pycor = 1 ]
    [sprout-foresters 1 [
      set shape "person logger"
      set color green
      set size 1.2 ] ]

  ask patches with [pxcor = 6 and pycor = 1 ]
    [sprout-foresters 1 [
      set shape "person logger"
      set color red
      set size 1.2] ]

  set farmers1 turtle-set foresters-on forest1
  set farmers2 turtle-set foresters-on forest2

  ask farmers1 [ init-learning Percent-cut1 ]
  ask farmers2 [ init-learning Percent-cut2 ]
end

to init-learning [start-level]
  set cut-level start-level
  set amount start-level
  set block-b []
  set block-p []
  set prev-block-mean -1
  set first-block-p -1
  set last-S 0
  set pending-S 0
  set last-change 0
  set s-log []
  set change-log []
end

;;;;;;;;;;;;;;;;;;;;;;;;
;;;Runtime Procedures;;;
;;;;;;;;;;;;;;;;;;;;;;;;

to go
  ifelse Private-forest?
  [ if not any? fences [ setup-fence ] ]
  [ ask fences [ die ] ]

  ask foresters [ choose-level ]

  cut-trees

  ask foresters [ record-trial ]

  ask trees [ regrow ]

  tick
end

;; each tick a forester tries a harvest percent close to its current typical level
to choose-level
  set amount clamp-percent (cut-level + random-normal 0 Exploration)
end

to cut-trees
  ifelse Private-forest?
  [harvest-private]
  [harvest-commons]

  ask foresters [set wealth wealth + harvest]
end

to harvest-private
  ask farmers1 [
    if member? patch-here forest1 = false [ move-to one-of forest1]
    let trees1 trees-on forest1
    let harvest-tree max-one-of (trees1 in-radius 1) [height]
    move-to harvest-tree
    set harvest (  [height] of harvest-tree  * amount / 100)
    ask  harvest-tree [set height (height - (height * [amount ] of myself / 100))]
  ]

  ask farmers2 [
    if member? patch-here forest2 = false [ move-to one-of forest2]
    let trees2 trees-on forest2
    let harvest-tree max-one-of (trees2 in-radius 1) [height]
    move-to harvest-tree
    set harvest (  [height] of harvest-tree  * amount / 100)
    ask  harvest-tree [set height (height - (height * [amount ] of myself / 100))]
  ]
end

to harvest-commons
  ask foresters [
    let harvest-tree max-one-of (trees in-radius 2) [height]
    move-to harvest-tree
    set harvest (  [height] of harvest-tree  * ( amount / 100))
    ask  harvest-tree [set height (height - (height * [amount ] of myself / 100))]
  ]
end

to regrow ;; tree
  ifelse height > 0
  [ set height  (height + ((Growth-Rate * height) * (1 - (height / ( Max-Treeheight)  ))))
  ]
  [set height 0.01]
  set size height / 100
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;Learning from what paid off;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to record-trial
  set block-b lput amount block-b
  set block-p lput harvest block-p
  if length block-b >= Block-length [ finish-block ]
end

;; At the end of a block the forester looks at how harvest percent and wood taken moved together.
;; S = Cov(percent, wood) / mean wood. This is the selection term of the covariance based law of effect
;; (Borgstede and Eggert 2021, equation 7) with the payoff itself as the fitness predictor and a slope of 1.
;; The law predicts that the mean harvest percent of the next block differs from this block's mean by S.
to finish-block
  let b-mean mean block-b
  let p-mean mean block-p
  let s 0
  if p-mean > 0 [ set s (covariance block-b block-p) / p-mean ]

  if first-block-p < 0 [ set first-block-p p-mean ]

  if prev-block-mean >= 0 [
    set last-change b-mean - prev-block-mean
    set s-log lput pending-S s-log
    set change-log lput last-change change-log
    plot-pair pending-S last-change
  ]

  set last-S s
  set pending-S s
  set prev-block-mean b-mean

  if Learning-rule = "toward payoff"    [ set cut-level clamp-percent (b-mean + Learning-rate * s) ]
  if Learning-rule = "away from payoff" [ set cut-level clamp-percent (b-mean - Learning-rate * s) ]
  ;; "no learning" leaves cut-level where it is

  set block-b []
  set block-p []
end

to plot-pair [predicted observed]
  set-current-plot "Predicted vs observed change"
  ifelse member? self farmers1
  [ set-current-plot-pen "Forester 1" ]
  [ set-current-plot-pen "Forester 2" ]
  plotxy predicted observed
end

to-report clamp-percent [x]
  report max list 1 min list 100 x
end

to-report covariance [xs ys]
  report (mean (map [ [x y] -> x * y ] xs ys)) - (mean xs) * (mean ys)
end

;; correlation of two lists, -9 when it cannot be computed
to-report corr [xs ys]
  if length xs < 3 [ report -9 ]
  let mx mean xs
  let my mean ys
  let sx sqrt mean map [ x -> (x - mx) ^ 2 ] xs
  let sy sqrt mean map [ y -> (y - my) ^ 2 ] ys
  if sx = 0 or sy = 0 [ report -9 ]
  report (mean (map [ [x y] -> (x - mx) * (y - my) ] xs ys)) / (sx * sy)
end

to-report forester-corr [f]
  report corr ([s-log] of f) ([change-log] of f)
end

;; share of compared blocks in which the observed change has the sign of the prediction, -9 when none
to-report forester-sign-agreement [f]
  let ss [s-log] of f
  let cs [change-log] of f
  let n 0
  let hit 0
  (foreach ss cs [ [s c] ->
    if abs s > 0.000001 [
      set n n + 1
      if s * c > 0 [ set hit hit + 1 ]
    ]
  ])
  ifelse n = 0 [ report -9 ] [ report hit / n ]
end

to-report forest-stock
  report sum [height] of trees / (Max-Treeheight * count patches) * 100
end
]]></code>
