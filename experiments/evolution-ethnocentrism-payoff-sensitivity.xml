<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment name="Ethnocentrism: Payoff Matrix Sensitivity" repetitions="10" runMetricsEveryStep="false">
    <setup>setup-full</setup>
    <go>go</go>
    <timeLimit steps="1000"/>
    <exitCondition>count turtles = 0</exitCondition>
    <metric>count turtles with [color = green] / count turtles</metric>
    <metric>count turtles with [color = orange] / count turtles</metric>
    <metric>count turtles with [color = turquoise] / count turtles</metric>
    <metric>count turtles with [color = red] / count turtles</metric>
    <metric>count turtles</metric>
    
    <enumeratedValueSet variable="interaction">
      <value value="local"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="offspring-placement">
      <value value="local"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="Number-ethnicities">
      <value value="2"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="Percent-cooperate-with-same">
      <value value="50"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="Percent-cooperate-with-different">
      <value value="50"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="Living-costs">
      <value value="2"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="Mutation-rate">
      <value value="0.5"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="Death-rate">
      <value value="0.5"/>
    </enumeratedValueSet>
    
    <!-- Vary the payoff for mutual cooperation (A) -->
    <steppedValueSet var="A" first="1" step="1" last="5"/>
    
    <enumeratedValueSet variable="B">
      <value value="5"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="C">
      <value value="0"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="D">
      <value value="1"/>
    </enumeratedValueSet>
  </experiment>
</experiments>