<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment name="Two Foresters: Harvest vs Regrowth Balance" repetitions="10" runMetricsEveryStep="false">
    <setup>setup</setup>
    <go>go</go>
    <timeLimit steps="500"/>
    <exitCondition>count trees = 0</exitCondition>
    <metric>count trees</metric>
    <metric>sum [energy] of foresters</metric>
    <metric>count foresters with [strategy = "modest"]</metric>
    <metric>count foresters with [strategy = "greedy"]</metric>
    
    <!-- Vary harvest rates -->
    <steppedValueSet var="harvest-rate-1" first="1" step="1" last="5"/>
    <steppedValueSet var="harvest-rate-2" first="1" step="1" last="5"/>
    
    <!-- Vary regrowth rate -->
    <steppedValueSet var="regrowth-rate" first="1" step="1" last="5"/>
    
    <!-- Vary initial strategies -->
    <enumeratedValueSet variable="initial-strategy-1">
      <value value="modest"/>
      <value value="greedy"/>
    </enumeratedValueSet>
    
    <enumeratedValueSet variable="initial-strategy-2">
      <value value="modest"/>
      <value value="greedy"/>
    </enumeratedValueSet>
  </experiment>
</experiments>