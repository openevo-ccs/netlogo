<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generic, model-agnostic BehaviorSpace smoke test: run setup, run go
  20 times, report ticks. Used against a real model.nlogo via NetLogo
  6.4.0's headless launcher (the setup-file/experiment flags). All 14
  models in the collection declare conventional setup and go procedures
  (confirmed by grep before writing this), so one experiment file works
  unmodified across the whole collection. This is not a substantive
  correctness check; it only confirms the real model actually compiles
  and ticks without a runtime error, which model_card.py's regex based
  parser can't verify on its own.
-->
<experiments>
  <experiment name="smoke" repetitions="1" runMetricsEveryStep="false">
    <setup>setup</setup>
    <go>go</go>
    <timeLimit steps="20"/>
    <metric>ticks</metric>
  </experiment>
</experiments>
